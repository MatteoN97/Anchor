<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="How are you feeling?"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="14sp"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView android:id="@+id/mood_5" style="@style/MoodNotificationChoice" android:text="😊&#10;Great" />
        <TextView android:id="@+id/mood_4" style="@style/MoodNotificationChoice" android:text="🙂&#10;Good" />
        <TextView android:id="@+id/mood_3" style="@style/MoodNotificationChoice" android:text="😐&#10;Okay" />
        <TextView android:id="@+id/mood_2" style="@style/MoodNotificationChoice" android:text="😔&#10;Low" />
        <TextView android:id="@+id/mood_1" style="@style/MoodNotificationChoice" android:text="😢&#10;Not great" />
    </LinearLayout>
</LinearLayout>
