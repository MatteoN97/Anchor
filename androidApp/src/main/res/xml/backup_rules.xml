<?xml version="1.0" encoding="utf-8"?><!--
    Full-backup rules, used on API 30 and below (minSdk here is 24).

    Anchor holds therapy notes, so the database and the preferences must never leave the device
    through Google's backup transport. Everything else is allowed, which today is nothing.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
