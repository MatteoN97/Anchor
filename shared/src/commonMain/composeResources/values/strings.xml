    <!-- Built-in coping techniques -->
    <string name="builtin_478_name">4-7-8 Breathing</string>
    <string name="builtin_478_description">Inhale 4s, hold 7s, exhale 8s. Activates the parasympathetic nervous system.</string>
    <string name="builtin_54321_name">5-4-3-2-1 Grounding</string>
    <string name="builtin_54321_description">Name 5 things you see, 4 you hear, 3 you can touch, 2 you smell, 1 you taste.</string>
    <string name="builtin_reach_out_name">Reach out</string>
    <string name="builtin_reach_out_description">Text or call someone you trust, even just to say hi.</string>
    <string name="builtin_comfort_object_name">Comfort object</string>
    <string name="builtin_comfort_object_description">Hold something soft or familiar. Let yourself feel it.</string>
    <string name="builtin_cold_water_name">Cold water</string>
    <string name="builtin_cold_water_description">Splash cold water on your face or hold ice. It triggers the dive reflex and slows your heart rate.</string>
    <string name="builtin_move_name">Move your body</string>
    <string name="builtin_move_description">Even 60 seconds of jumping jacks or walking can release tension.</string>
    <string name="builtin_temperature_name">Temperature change</string>
    <string name="builtin_temperature_description">Hold something cold or warm. Focus entirely on the sensation.</string>
    <string name="builtin_one_thing_name">One thing only</string>
    <string name="builtin_one_thing_description">Pick one tiny thing to do. Just one. Nothing else matters right now.</string>
    <string name="builtin_rest_name">Rest without guilt</string>
    <string name="builtin_rest_description">Lie down. You don't have to be productive right now.</string>

